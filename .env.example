# Copie para .env (que NUNCA vai para o git) e preencha.
# Em produção, configure estas variáveis no painel da hospedagem.

DJANGO_SETTINGS_MODULE=config.settings.dev

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Endereço do painel (evite /admin/)
DJANGO_ADMIN_URL=painel/
DJANGO_ADMINS=

# Postgres (deixe DB_NAME vazio para usar SQLite só no desenvolvimento)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# Criptografia de campos sensíveis (CPF/CNPJ).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Para rotacionar: coloque a nova chave na frente, separada por vírgula, e mantenha a antiga.
FIELD_ENCRYPTION_KEYS=
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
FIELD_HASH_KEY=

# LGPD
LGPD_VERSAO_POLITICA=2026-11
LGPD_RETENCAO_IP_DIAS=180
LGPD_CONTATO_ENCARREGADO=privacidade@stronglasses.com.br
SECURITY_CONTATO=seguranca@stronglasses.com.br

# Produção
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_PRELOAD=false
DJANGO_BEHIND_PROXY=false

# E-mail transacional
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Strong Glasses <nao-responda@stronglasses.com.br>

# Importação da Nuvemshop (ver docs/IMPORTACAO.md). Apague depois da migração.
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=

# Servidor (homologação/produção)
# DJANGO_AMBIENTE=testes        -> faixa de aviso no topo e nada indexado no Google
# DJANGO_SERVIR_MEDIA=1         -> o próprio Django serve as fotos (/media/) sem CDN
# DJANGO_BEHIND_PROXY=1         -> atrás do proxy HTTPS da hospedagem
# DJANGO_MEDIA_ROOT=/dados/media -> pasta do volume persistente
